# Puerto de la API local
PORT=3000

# Origenes permitidos por CORS, separados por coma. Sin barra final.
# Local + produccion: http://127.0.0.1:5173,https://cyborg-front.onrender.com
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Cadena de conexion de MongoDB Atlas. Reemplaza USUARIO, CONTRASENA, CLUSTER y
# BASE_DE_DATOS por los datos reales de tu cluster. Si la contrasena contiene
# caracteres especiales, debes codificarlos en la URL (por ejemplo, @ -> %40).
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/BASE_DE_DATOS?retryWrites=true&w=majority

# Opcional: base de datos de pruebas para `npm run test:integration`.
# No apuntes esta variable a la base de datos real de trabajo.
# TEST_MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/BASE_DE_DATOS_PRUEBAS?retryWrites=true&w=majority
